<% layout('/layouts/boilerplate') %>

<body>
    <form action="/home/Login" method="POST" novalidate style="width: 100%; height: 100%;">
        <div class="border border-2 rounded col-4 mt-5 mx-auto p-2">
            <h3 class="offset-5 text-primary">Log in</h3>
            <hr>
            <div>
                <label for="username" class=" fw-semibold fs-6">User_Name</label>
                <input type="text" class="form-control" placeholder="OP_Ankit.." aria-label="username" id="username" name="username" required>
            </div>
            <div>
                <label for="password" class="fw-semibold fs-6">Password</label>
                <input type="password" class="form-control" placeholder="X1@yafj" aria-label="Last name" id="password" name="password" required>
            </div>
            <button class="btn btn-primary mt-2" type="submit">Login</button>
            <hr>
            <span class="mx-auto p-5"> &nbsp; &nbsp;Don't have the Account ?
                <span class="text-primary">
                    <a href="http://localhost:3000/home/SignUp">
                        SignUp
                    </a>
                </span>
            </span>
        </div>
    </form>
</body>