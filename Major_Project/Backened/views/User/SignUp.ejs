<% layout('/layouts/boilerplate') %>

<body>
    <form action="/home/SignUp" method="POST">
        <div class="border border-2 rounded col-4 mt-5 mx-auto p-2">
            <h3 class="offset-4 text-primary">Sign Up</h3>
            <hr>
            <div>
                <label for="FristName"> Frist Name</label>
                <input type="text" class="form-control " placeholder="First name" aria-label="First name"
                    id="FristName" name="FristName" required>
            </div>
            <div class="valid-feedback">Looks Good</div>
            <div>
                <label for="LastName">Last Name</label>
                <input type="text" class="form-control" placeholder="Last name" aria-label="Last name"
                    id="LastName"  name="LastName" required>
            </div>
            <div>
                <label for="email">Email</label>
                <input type="text" class="form-control" placeholder="abc@gmail.com" aria-label="First name"
                    id="email" name="email" required>
            </div>
            <div>
                <label for="username">User_Name</label>
                <input type="text" class="form-control" placeholder="xyz" aria-label="username" id="username"  name="username" required>
            </div>
            <div>
                <label for="password">Password</label>
                <input type="password" class="form-control" placeholder="x45!s" aria-label="Last name" id="password" name="password" >
            </div>
            <button class="btn btn-success mt-2" type="submit">Sign Up</button>
            <hr>
            <span class="mx-auto p-5"> &nbsp; &nbsp;Already have the Account ?
                <span class="text-primary">
                    <a href="http://localhost:3000/home/Login">
                        Log in
                    </a>
                </span>
            </span>
        </div>
    </form>
</body>