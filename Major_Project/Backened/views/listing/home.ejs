<% layout("/layouts/boilerplate") %>
<body>
    <p><button><a href="/home/add">Add</a></button></p>
    <% for(hotel of All_hotels) {%>
            <div class="outer">
            <div class="inner">
                <a href="http://localhost:3000/home/<%= hotel.id %>/show"><img src="<%=hotel.image.url %>" alt="Image missing"></a>
            </div>
            <div class="inner_info">
                <p>Title:<%=hotel.title%></p>
                <p>Price: &#8377; <%=hotel.price%></p>

                <div>
                    Detail button
                    <button><a href="http://localhost:3000/home/<%= hotel.id %>/show">Details</a></button>
                    Add Button
                     <button><a href="http://localhost:3000/home/<%= hotel.id %>/update">Update</a></button>
                    Destroy
                     <form action="/home/<%= hotel.id %>?_method=DELETE" method="post">
                        <button type="">Delete</button>
                     </form>
                </div>
            </div>
            
        </div>
    <% } %>
</body>
</html>