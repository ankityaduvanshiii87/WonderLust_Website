<% layout("layouts/boilerplate.ejs") %>
<style>
    #filters{
        display: flex;
        flex-wrap: wrap;
        width: 95%;
        text-align: center;
    }
    .filter{
        margin-left: 2rem;
        margin-top: 2rem;
        opacity: 0.8;
    }
    .filter:hover{
        opacity: 1;
    }
    .toogleBtn{
        border: 2px solid black;
        border-radius: 8px;
        padding: 10px 7px 10px 7px;
        height: 3rem;
        margin-left: 7rem;
        opacity: 1;
    }
    .gstPrice{
        display:none;
    }
</style>
<body>
    <div id="filters" >
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Bed</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bowl-food"></i></div>
            <p>Food</p>
        </div>
                <div class="filter">
            <div><i class="fa-solid fa-city"></i></div>
            <p>City</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Bed</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bowl-food"></i></div>
            <p>Food</p>
        </div>
                <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Bed</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bowl-food"></i></div>
            <p>Food</p>
        </div>
                <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Bed</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bowl-food"></i></div>
            <p>Food</p>
        </div>
        <!-- Toggle Button -->
        <div class=" filter toogleBtn" >
           <div class="form-check form-switch form-check-reverse">
             <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
             <label class="form-check-label" for="switchCheckDefault">Show GST Applied</label>
           </div>
        </div>
    </div>
    <div class="row" >
        <% for(hotel of listing){ %>
            <div class="card" style="width: 18rem;">
                <a href="/home/<%=hotel.id%>/show" class="text-decorate">
                 <img src=<%=hotel.image.url %> class="card-img-top" alt="missing Image">
                 <div class="card-body ">
                     <h6 class="card-title " ><%=hotel.title %></h6>
                     <p> &#8377; <%= hotel.price.toLocaleString("en-IN") %>/night   &nbsp;&nbsp;&nbsp;&nbsp;
                        <i class="gstPrice"> &nbsp;&nbsp; -- +18% GST</i>
                    </p>
                 </div>
                 <p><a></a></p>
                </a>
            </div>
        <% } %>
    </div>  
</body>
