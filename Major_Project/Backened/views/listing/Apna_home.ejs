<% layout("layouts/boilerplate.ejs") %>
<body>
    <h1>All Listings</h1>  
    <div class="row" >
        <% for(hotel of listing){ %>
            <div class="card" style="width: 18rem;">
                <a href="http://localhost:3000/home/<%=hotel.id%>/show" class="text-decorate">
                 <img src=<%=hotel.image.url %> class="card-img-top" alt="missing Image">
                 <div class="card-body">
                     <h6 class="card-title" ><%=hotel.title %></h6>
                     <p> &#8377; <%= hotel.price.toLocaleString("en-IN") %>/night</p>
                 </div>
                 <p><a></a></p>
                </a>
            </div>
        <% } %>
    </div>  
    
</body>